    for (let i = 1; i < data.length; i++) {
      const rowEmail = String(data[i][1]).trim().toLowerCase();
      const rowPassword = String(data[i][5]).trim(); // Column F

      if (rowEmail === String(email || '').toLowerCase()) {
        MailApp.sendEmail({
          to: email,
          subject: 'TMS Password Recovery',
          body: `Hello,\n\nYour password for the Training Management System is: ${rowPassword}\n\nPlease keep this information secure.\n\nBest regards,\nTMS Team`
        });

        return { success: true, message: 'Password sent to your email' };
      }
    }

    return { success: false, message: 'Email not found in our records' };
  } catch (error) {
    return { success: false, message: error.message };
  }
}

function getUserPermissions(userType) {
  const type = (userType || '').toLowerCase().trim();

  if (type === 'trainer') {
    return {
      ilt: { dashboard: true, progress: true, evaluations: true, reports: true },
      sbl: { dashboard: true, videos: true, evaluations: true, reports: true },
