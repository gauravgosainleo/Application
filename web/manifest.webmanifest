{
  "name": "G VI Fan Hub",
  "short_name": "G VI Hub",
  "description": "Fan companion app for Grand Theft Auto VI: countdown, news, trailers, Leonida map, friends & chat, discussions, polls, events and rewards.",
  "id": "./",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0a0612",
  "theme_color": "#0a0612",
  "categories": ["entertainment", "games", "social"],
  "icons": [
    { "src": "assets/img/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/img/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Countdown", "url": "./#/countdown", "icons": [{ "src": "assets/img/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Leonida Map", "url": "./#/map", "icons": [{ "src": "assets/img/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Chat", "url": "./#/friends", "icons": [{ "src": "assets/img/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "News", "url": "./#/news", "icons": [{ "src": "assets/img/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
