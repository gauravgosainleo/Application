function getQuizQuestions(application, testNumber) {
  try {
    const ss = getSpreadsheet();
    const sheet = ss.getSheetByName(QUIZ_SHEET_NAME);
    if (!sheet || sheet.getLastRow() < 2) return { success: false, message: 'Quiz sheet not found or empty', questions: [] };
    const data = sheet.getRange(2, 1, sheet.getLastRow() - 1, 8).getValues();
    const questions = [];
    data.forEach((row, index) => {
      const rowApp = String(row[0]).trim().toLowerCase();
      const rowTest = String(row[1]).trim().toLowerCase();
      if (rowApp === String(application).trim().toLowerCase() && rowTest === String(testNumber).trim().toLowerCase()) {
        questions.push({ questionId: index + 2, question: row[2], optionA: row[3], optionB: row[4], optionC: row[5], optionD: row[6] });
      }
    });
    if (questions.length === 0) return { success: false, message: 'No questions found for ' + application + ' - ' + testNumber, questions: [] };
    for (let i = questions.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [questions[i], questions[j]] = [questions[j], questions[i]];
    }
    return { success: true, questions: questions };
  } catch (error) { console.error('Error getting quiz questions:', error); return { success: false, message: error.message, questions: [] }; }
}

function submitQuizAnswers(submissionData) {
  try {
    initializeQuizSheets();
    const ss = getSpreadsheet();
    const quizSheet = ss.getSheetByName(QUIZ_SHEET_NAME);
    const assignSheet = ss.getSheetByName(ASSIGNED_QUIZ_SHEET_NAME);
    const resultsSheet = ss.getSheetByName(QUIZ_RESULTS_SHEET_NAME);
    if (!quizSheet || !assignSheet || !resultsSheet) return { success: false, message: 'Required sheets not found' };
    const quizData = quizSheet.getRange(2, 1, quizSheet.getLastRow() - 1, 8).getValues();
    const correctAnswers = {};
    quizData.forEach((row, index) => {
      const rowApp = String(row[0]).trim().toLowerCase();
      const rowTest = String(row[1]).trim().toLowerCase();
      if (rowApp === String(submissionData.application).trim().toLowerCase() && rowTest === String(submissionData.testNumber).trim().toLowerCase()) {
        correctAnswers[index + 2] = String(row[7]).trim().toUpperCase();
      }
    });
    let correctCount = 0;
    const totalQuestions = Object.keys(submissionData.answers).length;
    const answerDetails = [];
    for (const [questionId, answer] of Object.entries(submissionData.answers)) {
      const correctAnswer = correctAnswers[parseInt(questionId)];
      const isCorrect = String(answer).trim().toUpperCase() === correctAnswer;
      if (isCorrect) correctCount++;
      answerDetails.push({ questionId: questionId, userAnswer: answer, correctAnswer: correctAnswer, isCorrect: isCorrect });
    }
    const scorePercentage = totalQuestions > 0 ? Math.round((correctCount / totalQuestions) * 100) : 0;
    const lastResultRow = resultsSheet.getLastRow();
    let nextResultId = 1;
    if (lastResultRow > 1) {
      const lastId = resultsSheet.getRange(lastResultRow, 1).getValue();
      const idNum = parseInt(String(lastId).replace('QR', '')) || 0;
      nextResultId = idNum + 1;
    }
    const resultId = 'QR' + String(nextResultId).padStart(5, '0');
    const submittedDate = new Date();
    resultsSheet.appendRow([
      resultId, submissionData.assignmentId, submissionData.batch, submissionData.traineeEmail,
      submissionData.traineeName, submissionData.application, submissionData.testNumber,
      totalQuestions, correctCount, scorePercentage, submittedDate, submissionData.timeTaken || 0,
      JSON.stringify(answerDetails)
    ]);
    const assignData = assignSheet.getRange(2, 1, assignSheet.getLastRow() - 1, 10).getValues();
    for (let i = 0; i < assignData.length; i++) {
      if (assignData[i][0] === submissionData.assignmentId) {
        assignSheet.getRange(i + 2, 9).setValue('Completed');
        break;
      }
    }
    return { success: true, message: 'Quiz submitted successfully', resultId: resultId, totalQuestions: totalQuestions, correctAnswers: correctCount, scorePercentage: scorePercentage, answerDetails: answerDetails };
  } catch (error) { console.error('Error submitting quiz:', error); return { success: false, message: error.message }; }
}

function getQuizResultsForTrainer(filters) {
