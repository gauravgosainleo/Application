/**
 * Settings action: delete a Training Category (trainer only)
 */
function deleteTrainingCategoryOption(category, userEmail) {
  assertTrainer_(userEmail);

  const value = String(category || '').trim();
  if (!value) return { success: false, message: 'Category cannot be empty.' };

  const sheet = ensureSettingsSheet_();
  const lastRow = sheet.getLastRow();

  if (lastRow < 2) {
    return { success: false, message: 'No categories to delete.' };
  }

  const catValues = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
  let rowToDelete = -1;

  for (let i = 0; i < catValues.length; i++) {
    if (String(catValues[i][0]).trim().toLowerCase() === value.toLowerCase()) {
      rowToDelete = i + 2; // +2 because we start from row 2
      break;
    }
  }

  if (rowToDelete === -1) {
    return { success: false, message: 'Category not found.' };
  }

  // Clear the cell instead of deleting the row to preserve application column alignment
  sheet.getRange(rowToDelete, 1).clearContent();

  // Compact the column by removing empty cells
  compactSettingsColumn_(sheet, 1);

  return { success: true, message: 'Training category deleted successfully.' };
}

/**
 * Settings action: delete an Application (trainer only)
 */
function deleteApplicationOption(application, userEmail) {
  assertTrainer_(userEmail);

  const value = String(application || '').trim();
  if (!value) return { success: false, message: 'Application cannot be empty.' };

  const sheet = ensureSettingsSheet_();
  const lastRow = sheet.getLastRow();

  if (lastRow < 2) {
    return { success: false, message: 'No applications to delete.' };
  }

  const appValues = sheet.getRange(2, 3, lastRow - 1, 1).getValues();
  let rowToDelete = -1;

  for (let i = 0; i < appValues.length; i++) {
    if (String(appValues[i][0]).trim().toLowerCase() === value.toLowerCase()) {
      rowToDelete = i + 2;
      break;
    }
  }

  if (rowToDelete === -1) {
    return { success: false, message: 'Application not found.' };
  }

  sheet.getRange(rowToDelete, 3).clearContent();
  compactSettingsColumn_(sheet, 3);

  return { success: true, message: 'Application deleted successfully.' };
}

/**
 * Helper to compact a column by moving non-empty cells up
 */
function compactSettingsColumn_(sheet, col) {
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;

  const values = sheet.getRange(2, col, lastRow - 1, 1).getValues();
  const nonEmpty = values.filter(row => String(row[0]).trim() !== '');

  // Clear the column from row 2 onwards
  sheet.getRange(2, col, lastRow - 1, 1).clearContent();

  // Write back non-empty values
  if (nonEmpty.length > 0) {
    sheet.getRange(2, col, nonEmpty.length, 1).setValues(nonEmpty);
  }
}

// ==================== AUTHENTICATION ====================

function authenticateUser(email, password) {
  try {
    const ss = getSpreadsheet();
    const sheet = ss.getSheetByName(LOGIN_SHEET_NAME);

    if (!sheet) {
      return { success: false, message: 'Login sheet not found' };
    }

    const data = sheet.getDataRange().getValues();

    for (let i = 1; i < data.length; i++) {
      const rowEmail = String(data[i][1]).trim().toLowerCase(); // Column B
      const rowPassword = String(data[i][5]).trim(); // Column F
      const rowType = String(data[i][6]).trim(); // Column G
      const rowName = String(data[i][0]).trim(); // Column A

      if (rowEmail === String(email || '').toLowerCase() && rowPassword === String(password || '')) {
        return {
          success: true,
          user: {
            email: rowEmail,
            name: rowName || rowEmail.split('@')[0],
            type: rowType || 'Trainee'
          }
        };
      }
    }

    return { success: false, message: 'Invalid email or password' };
  } catch (error) {
    return { success: false, message: error.message };
  }
}

function sendPasswordRecovery(email) {
  try {
    const ss = getSpreadsheet();
    const sheet = ss.getSheetByName(LOGIN_SHEET_NAME);

    if (!sheet) {
      return { success: false, message: 'Login sheet not found' };
    }

