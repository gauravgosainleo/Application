# Copy to keystore.properties (which git ignores) to sign release builds locally:
#   ./gradlew bundleRelease      -> app/build/outputs/bundle/release/app-release.aab
#   ./gradlew assembleRelease    -> app/build/outputs/apk/release/app-release.apk
# Never commit the real file or the keystore: this repository is public.
storeFile=/absolute/path/to/uninav-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
