function getHolidays() {
  try {
    const ss = getSpreadsheet();
    const sheet = ss.getSheetByName('Holidays');

    if (!sheet || sheet.getLastRow() < 2) {
      return [];
    }

    const data = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues();
