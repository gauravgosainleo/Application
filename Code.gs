        quizzes.push({
          assignmentId: row[0], batch: row[1], application: application, testNumber: testNumber,
          assignedBy: row[6],
          assignedDate: row[7] ? Utilities.formatDate(new Date(row[7]), Session.getScriptTimeZone(), 'yyyy-MM-dd') : '-',
          dueDate: row[9] ? Utilities.formatDate(new Date(row[9]), Session.getScriptTimeZone(), 'yyyy-MM-dd') : '-',
          questionCount: questionCounts[key] || 0, rowIndex: index + 2
        });
      }
    });
    return { quizzes: quizzes };
  } catch (error) { console.error('Error getting pending quizzes:', error); return { quizzes: [], error: error.message }; }
}

