function getReportsAndCertificationData(filters) {
  try {
    initializeQuizSheets();
    const ss = getSpreadsheet();
    const resultsSheet = ss.getSheetByName(QUIZ_RESULTS_SHEET_NAME);
    const assignSheet = ss.getSheetByName(ASSIGNED_QUIZ_SHEET_NAME);
    const response = {
      tiles: { totalEvaluations: 0, totalPassed: 0, totalFailed: 0, totalCertifications: 0 },
      reports: [], certifications: [],
      filterOptions: { batches: [], testNumbers: [], applications: [] }
    };
    try {
      const certSheet = ss.getSheetByName('Individual_Certifications');
      if (certSheet && certSheet.getLastRow() >= 2) {
        const certData = certSheet.getRange(2, 1, certSheet.getLastRow() - 1, 9).getValues();
        certData.forEach(row => {
          response.certifications.push({
            certificateId: row[0], employeeName: row[1], email: row[2], batchNumber: row[3],
            application: row[4], issueDate: formatDateForDisplay(row[5]), expiryDate: formatDateForDisplay(row[6]),
            issuedBy: row[7], createdAt: row[8]
          });
        });
        response.tiles.totalCertifications = response.certifications.length;
      }
    } catch (certError) { console.log('Certifications sheet not found or error:', certError); }
    if (assignSheet && assignSheet.getLastRow() > 1) {
      const assignData = assignSheet.getRange(2, 1, assignSheet.getLastRow() - 1, 10).getValues();
      const batchSet = new Set(), testSet = new Set(), appSet = new Set();
      assignData.forEach(row => {
        if (row[1] && String(row[1]).trim()) batchSet.add(String(row[1]).trim());
        if (row[5] && String(row[5]).trim()) testSet.add(String(row[5]).trim());
        if (row[4] && String(row[4]).trim()) appSet.add(String(row[4]).trim());
      });
      response.filterOptions.batches = [...batchSet].sort((a, b) => { return (parseInt(String(a).replace(/\D/g, ''), 10) || 0) - (parseInt(String(b).replace(/\D/g, ''), 10) || 0); });
      response.filterOptions.testNumbers = [...testSet].sort();
      response.filterOptions.applications = [...appSet].sort();
    }
    if (!resultsSheet || resultsSheet.getLastRow() < 2) return response;
    const data = resultsSheet.getRange(2, 1, resultsSheet.getLastRow() - 1, 13).getValues();
    const passThreshold = 70;
    data.forEach(row => {
      const batch = String(row[2]).trim();
      const application = String(row[5]).trim();
      const testNumber = String(row[6]).trim();
      const scorePercentage = Number(row[9]) || 0;
      const submittedDate = row[10];
      let includeInReport = true;
      if (filters) {
        if (filters.batch && filters.batch !== '' && batch !== filters.batch) includeInReport = false;
        if (filters.testNumber && filters.testNumber !== '' && testNumber !== filters.testNumber) includeInReport = false;
        if (filters.application && filters.application !== '' && application !== filters.application) includeInReport = false;
        if (filters.startDate && submittedDate) { if (new Date(submittedDate) < new Date(filters.startDate)) includeInReport = false; }
        if (filters.endDate && submittedDate) { const filterEnd = new Date(filters.endDate); filterEnd.setHours(23, 59, 59, 999); if (new Date(submittedDate) > filterEnd) includeInReport = false; }
      }
      if (includeInReport) {
        const isPassed = scorePercentage >= passThreshold;
        response.tiles.totalEvaluations++;
        if (isPassed) response.tiles.totalPassed++; else response.tiles.totalFailed++;
        response.reports.push({
          resultId: row[0], batch: batch || '-', traineeName: row[4] || '-', traineeEmail: row[3] || '-',
          application: application, testNumber: testNumber, totalQuestions: row[7] || 0,
          correctAnswers: row[8] || 0, score: scorePercentage, status: isPassed ? 'Pass' : 'Fail',
          submittedDate: submittedDate ? Utilities.formatDate(new Date(submittedDate), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm') : '-',
          timeTaken: row[11] || 0
        });
      }
    });
    response.reports.sort((a, b) => { if (a.submittedDate === '-') return 1; if (b.submittedDate === '-') return -1; return new Date(b.submittedDate) - new Date(a.submittedDate); });
    return response;
  } catch (error) { console.error('Error getting reports and certification data:', error); return { tiles: { totalEvaluations: 0, totalPassed: 0, totalFailed: 0 }, reports: [], filterOptions: { batches: [], testNumbers: [], applications: [] }, error: error.message }; }
}

function getAssignedTestNumbers() {
  try {
    const ss = getSpreadsheet();
    const assignSheet = ss.getSheetByName(ASSIGNED_QUIZ_SHEET_NAME);
    if (!assignSheet || assignSheet.getLastRow() < 2) return [];
    const data = assignSheet.getRange(2, 6, assignSheet.getLastRow() - 1, 1).getValues();
    const testNumbers = new Set();
    data.forEach(row => { if (row[0] && String(row[0]).trim()) testNumbers.add(String(row[0]).trim()); });
    return [...testNumbers].sort();
  } catch (error) { console.error('Error getting assigned test numbers:', error); return []; }
}

function exportReportsCSV(filters) {
  try {
    const data = getReportsAndCertificationData(filters);
    const reports = data.reports || [];
    if (reports.length === 0) return 'No data to export';
    const headers = ['Batch', 'Name', 'Email', 'Application', 'Test Number', 'Total Questions', 'Correct Answers', 'Score (%)', 'Status', 'Submitted Date', 'Time Taken (seconds)'];
    let csv = headers.join(',') + '\n';
    reports.forEach(r => {
      csv += [r.batch || '-', '"' + (r.traineeName || '-').replace(/"/g, '""') + '"', r.traineeEmail || '-', '"' + (r.application || '-').replace(/"/g, '""') + '"', r.testNumber || '-', r.totalQuestions || 0, r.correctAnswers || 0, r.score || 0, r.status || '-', r.submittedDate || '-', r.timeTaken || 0].join(',') + '\n';
    });
    return csv;
  } catch (error) { console.error('Error exporting reports CSV:', error); return 'Error exporting data: ' + error.message; }
}

// ==================== INDIVIDUAL CERTIFICATION FUNCTIONS ====================

function initializeCertificationsSheet() {
  const ss = getSpreadsheet();
  let sheet = ss.getSheetByName('Individual_Certifications');
  if (!sheet) {
    sheet = ss.insertSheet('Individual_Certifications');
    sheet.appendRow(['Certificate ID', 'Employee Name', 'Email', 'Batch Number', 'Application', 'Issue Date', 'Expiry Date', 'Issued By', 'Created At']);
    sheet.getRange(1, 1, 1, 9).setFontWeight('bold').setBackground('#4285f4').setFontColor('white');
    sheet.setFrozenRows(1);
  }
  return sheet;
}

function getRegisteredTrainingEmployees() {
  try {
    const ss = getSpreadsheet();
    const sheet = ss.getSheetByName('ILT');
    if (!sheet || sheet.getLastRow() < 2) return [];
    const data = sheet.getRange(2, 1, sheet.getLastRow() - 1, 9).getValues();
    const employeesMap = {};
    data.forEach(row => {
      const email = String(row[4]).toLowerCase().trim();
      const name = String(row[3]).trim();
      if (email && name && !employeesMap[email]) employeesMap[email] = { name: name, email: email };
    });
    return Object.values(employeesMap).sort((a, b) => a.name.localeCompare(b.name));
  } catch (error) { console.error('Error getting registered employees:', error); return []; }
}

function generateCertificateId() {
  const timestamp = new Date().getTime().toString(36).toUpperCase();
  const random = Math.random().toString(36).substring(2, 6).toUpperCase();
  return 'CERT-' + timestamp + '-' + random;
}

function generateIndividualCertification(certData) {
  try {
    const sheet = initializeCertificationsSheet();
    const certificateId = generateCertificateId();
    sheet.appendRow([certificateId, certData.employeeName, certData.email, certData.batchNumber, certData.application, certData.issueDate, certData.expiryDate, certData.issuedBy, new Date().toISOString()]);
    return { success: true, message: 'Certificate generated successfully', certificateId: certificateId };
  } catch (error) { console.error('Error generating certification:', error); return { success: false, message: 'Failed to generate certificate: ' + error.message }; }
}

function getAllCertifications(userEmail, userType) {
  try {
    const ss = getSpreadsheet();
    const sheet = ss.getSheetByName('Individual_Certifications');
    if (!sheet || sheet.getLastRow() < 2) return [];
    const data = sheet.getRange(2, 1, sheet.getLastRow() - 1, 9).getValues();
    const certifications = [];
    data.forEach(row => {
      const cert = { certificateId: row[0], employeeName: row[1], email: row[2], batchNumber: row[3], application: row[4], issueDate: formatDateForDisplay(row[5]), expiryDate: formatDateForDisplay(row[6]), issuedBy: row[7], createdAt: row[8] };
      const lowerUserType = (userType || '').toLowerCase().trim();
      if (lowerUserType === 'trainee') {
        if (String(cert.email).toLowerCase().trim() === String(userEmail).toLowerCase().trim()) certifications.push(cert);
      } else {
        certifications.push(cert);
      }
    });
    return certifications;
  } catch (error) { console.error('Error getting certifications:', error); return []; }
}

function formatDateForDisplay(date) {
  if (!date) return '';
  try {
    const d = new Date(date);
    if (isNaN(d.getTime())) return String(date);
    return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  } catch (e) { return String(date); }
}

