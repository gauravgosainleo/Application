// ==================== TRAINING DATA ====================

function getNextBatchNumber(category) {
  try {
    // Guard against missing category parameter
    category = category || 'ILT';

    const ss = getSpreadsheet();

    // Determine which sheet to check based on category
    const defaultCategories = ['ilt', 'sbl', 'isms', 'misc'];
    const isDefaultCategory = defaultCategories.includes(category.toLowerCase());
    const sheetName = isDefaultCategory ? 'ILT' : category;

    const sheet = ss.getSheetByName(sheetName);

    if (!sheet || sheet.getLastRow() < 2) {
      return 1;
    }

    const data = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues();
    let maxBatch = 0;

    data.forEach(row => {
      const batchNum = parseInt(String(row[0]).replace(/\D/g, ''), 10);
      if (!isNaN(batchNum) && batchNum > maxBatch) {
        maxBatch = batchNum;
      }
    });

    return maxBatch + 1;
  } catch (error) {
    console.error('Error getting next batch number:', error);
    return 1;
  }
}

function saveTrainingData(trainingData) {
  try {
    const ss = getSpreadsheet();

    // Determine which sheet to use based on category
    const defaultCategories = ['ilt', 'sbl', 'isms', 'misc'];
    const isDefaultCategory = defaultCategories.includes(trainingData.category.toLowerCase());
    const sheetName = isDefaultCategory ? 'ILT' : trainingData.category;

    let sheet = ss.getSheetByName(sheetName);

    // If custom category sheet doesn't exist, create it
    if (!sheet) {
      sheet = createCategorySheet_(sheetName);
    }

    if (!sheet) {
      return { success: false, message: 'Sheet not found and could not be created' };
    }

    const rowsToAdd = [];

    trainingData.applications.forEach(app => {
      trainingData.levels.forEach(level => {
        trainingData.traineeEmails.forEach((email, i) => {
          const duration = calculateWorkingDays(trainingData.startDate, trainingData.endDate);
          rowsToAdd.push([
            trainingData.batchCount,
            trainingData.category,
            app,
            trainingData.traineeNames[i],
            email,
            level,
            trainingData.startDate,
            trainingData.endDate,
            duration
          ]);
        });
      });
    });

    if (rowsToAdd.length > 0) {
      const lastRow = sheet.getLastRow();
      sheet.getRange(lastRow + 1, 1, rowsToAdd.length, 9).setValues(rowsToAdd);
    }

    return { success: true, message: 'Training data saved successfully' };
  } catch (error) {
    console.error('Error saving training data:', error);
    return { success: false, message: error.message };
  }
}

function calculateWorkingDays(startDate, endDate) {
  try {
    const start = new Date(startDate);
    const end = new Date(endDate);
    const holidays = getHolidays();

    let count = 0;
    const current = new Date(start);

    while (current <= end) {
      const day = current.getDay();
      const dateStr = Utilities.formatDate(current, Session.getScriptTimeZone(), 'yyyy-MM-dd');

      if (day !== 0 && day !== 6 && !holidays.includes(dateStr)) {
        count++;
      }

      current.setDate(current.getDate() + 1);
    }

    return count;
  } catch (error) {
    console.error('Error calculating working days:', error);
    return 0;
  }
}

// ==================== ILT DATA FUNCTIONS ====================

function getILTDashboardData() {
  try {
    const ss = getSpreadsheet();
    const sheet = ss.getSheetByName('ILT');

    if (!sheet || sheet.getLastRow() < 2) {
      return { totalTrainings: 0, totalTrainees: 0, upcomingTrainings: 0, recentTrainings: [] };
    }

    const data = sheet.getRange(2, 1, sheet.getLastRow() - 1, 9).getValues();
    const today = new Date();

    const uniqueTrainings = new Set();
    const uniqueTrainees = new Set();
    let upcomingCount = 0;
    const recentTrainings = [];

    data.forEach(row => {
      if (row[0]) {
        uniqueTrainings.add(row[0] + '|' + row[2]);
        uniqueTrainees.add(row[4]);

        const startDate = new Date(row[6]);
        if (startDate > today) upcomingCount++;
      }
    });

    const seenTrainings = new Set();
    for (let i = data.length - 1; i >= 0 && recentTrainings.length < 10; i--) {
      const key = data[i][0] + '|' + data[i][2];
      if (data[i][0] && !seenTrainings.has(key)) {
        seenTrainings.add(key);
        const startDate = new Date(data[i][6]);
        const status = startDate > today ? 'Scheduled' : (new Date(data[i][7]) < today ? 'Completed' : 'In Progress');

        recentTrainings.push({
          name: data[i][2],
          category: data[i][1],
          startDate: Utilities.formatDate(new Date(data[i][6]), Session.getScriptTimeZone(), 'yyyy-MM-dd'),
          endDate: Utilities.formatDate(new Date(data[i][7]), Session.getScriptTimeZone(), 'yyyy-MM-dd'),
          status: status
        });
      }
    }

    return {
      totalTrainings: uniqueTrainings.size,
      totalTrainees: uniqueTrainees.size,
      upcomingTrainings: upcomingCount,
      recentTrainings: recentTrainings
    };
  } catch (error) {
    console.error('Error getting ILT dashboard data:', error);
    return { totalTrainings: 0, totalTrainees: 0, upcomingTrainings: 0, recentTrainings: [] };
  }
}

function getILTProgressData(userEmail) {
  try {
    const ss = getSpreadsheet();
    const sheet = ss.getSheetByName('ILT');

    if (!sheet || sheet.getLastRow() < 2) {
      return { trainings: [] };
    }

    const data = sheet.getRange(2, 1, sheet.getLastRow() - 1, 9).getValues();
    const trainings = [];
    const today = new Date();

    data.forEach(row => {
      if (row[4] && String(row[4]).toLowerCase() === String(userEmail).toLowerCase()) {
        const startDate = new Date(row[6]);
        const endDate = new Date(row[7]);

        let progress = 0;
        let status = 'Scheduled';

        if (today >= startDate && today <= endDate) {
          const totalDays = (endDate - startDate) / (1000 * 60 * 60 * 24);
          const elapsedDays = (today - startDate) / (1000 * 60 * 60 * 24);
          progress = Math.min(Math.round((elapsedDays / totalDays) * 100), 100);
          status = 'In Progress';
        } else if (today > endDate) {
          progress = 100;
          status = 'Completed';
        }

        trainings.push({
          name: row[2],
          level: row[5],
          progress: progress,
          status: status
        });
      }
    });

    return { trainings: trainings };
  } catch (error) {
    console.error('Error getting ILT progress data:', error);
    return { trainings: [] };
  }
}

function getILTEvaluationsData(userEmail) {
  try {
    const ss = getSpreadsheet();
    const sheet = ss.getSheetByName('ILT_Evaluations');

    if (!sheet || sheet.getLastRow() < 2) {
      return { evaluations: [] };
    }

    const data = sheet.getRange(2, 1, sheet.getLastRow() - 1, 8).getValues();
    const evaluations = [];

    data.forEach(row => {
      if (!userEmail || String(row[2]).toLowerCase() === String(userEmail).toLowerCase()) {
        evaluations.push({
          training: row[1],
          date: row[4] ? Utilities.formatDate(new Date(row[4]), Session.getScriptTimeZone(), 'yyyy-MM-dd') : '-',
          score: row[5] || '-',
          evaluator: row[3] || '-',
          status: row[7] || 'Pending'
        });
      }
    });

    return { evaluations: evaluations };
  } catch (error) {
    console.error('Error getting ILT evaluations data:', error);
    return { evaluations: [] };
  }
}

function getILTReportsData() {
  try {
