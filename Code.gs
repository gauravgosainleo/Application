    const questionCounts = {};
    quizData.forEach(row => {
      const app = String(row[0]).trim().toLowerCase();
      const test = String(row[1]).trim().toLowerCase();
      const key = app + '|' + test;
      questionCounts[key] = (questionCounts[key] || 0) + 1;
    });
    const data = assignSheet.getRange(2, 1, assignSheet.getLastRow() - 1, 10).getValues();
    const quizzes = [];
    data.forEach((row, index) => {
      const email = String(row[2]).toLowerCase().trim();
      const status = String(row[8]).trim();
      if (email === String(traineeEmail).toLowerCase().trim() && status === 'Pending') {
        const application = row[4];
        const testNumber = row[5];
