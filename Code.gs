function getQuizResultDetails(resultId) {
  try {
    const ss = getSpreadsheet();
    const resultsSheet = ss.getSheetByName(QUIZ_RESULTS_SHEET_NAME);
    const quizSheet = ss.getSheetByName(QUIZ_SHEET_NAME);
    if (!resultsSheet || resultsSheet.getLastRow() < 2) return { success: false, message: 'No results found' };
    const data = resultsSheet.getRange(2, 1, resultsSheet.getLastRow() - 1, 13).getValues();
    let result = null;
    for (const row of data) {
      if (row[0] === resultId) {
        result = {
          resultId: row[0], assignmentId: row[1], batch: row[2], traineeEmail: row[3], traineeName: row[4],
          application: row[5], testNumber: row[6], totalQuestions: row[7], correctAnswers: row[8],
          scorePercentage: row[9],
          submittedDate: row[10] ? Utilities.formatDate(new Date(row[10]), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm') : '-',
          timeTaken: row[11], answerDetails: row[12] ? JSON.parse(row[12]) : []
        };
        break;
      }
    }
    if (!result) return { success: false, message: 'Result not found' };
    const quizData = quizSheet.getRange(2, 1, quizSheet.getLastRow() - 1, 8).getValues();
    const questionMap = {};
    quizData.forEach((row, index) => {
      questionMap[index + 2] = { question: row[2], optionA: row[3], optionB: row[4], optionC: row[5], optionD: row[6], correctAnswer: row[7] };
    });
    result.answerDetails = result.answerDetails.map(detail => {
      const questionInfo = questionMap[parseInt(detail.questionId)] || {};
      return { ...detail, questionText: questionInfo.question || '', optionA: questionInfo.optionA || '', optionB: questionInfo.optionB || '', optionC: questionInfo.optionC || '', optionD: questionInfo.optionD || '' };
    });
    return { success: true, result: result };
  } catch (error) { console.error('Error getting quiz result details:', error); return { success: false, message: error.message }; }
}

function getQuizStatistics() {
  try {
    initializeQuizSheets();
    const ss = getSpreadsheet();
    const assignSheet = ss.getSheetByName(ASSIGNED_QUIZ_SHEET_NAME);
    const resultsSheet = ss.getSheetByName(QUIZ_RESULTS_SHEET_NAME);
    let totalAssigned = 0, pendingCount = 0, completedCount = 0, averageScore = 0;
    if (assignSheet && assignSheet.getLastRow() > 1) {
      const assignData = assignSheet.getRange(2, 9, assignSheet.getLastRow() - 1, 1).getValues();
      totalAssigned = assignData.length;
      assignData.forEach(row => {
        if (String(row[0]).trim() === 'Pending') pendingCount++;
        if (String(row[0]).trim() === 'Completed') completedCount++;
      });
    }
    if (resultsSheet && resultsSheet.getLastRow() > 1) {
      const resultsData = resultsSheet.getRange(2, 10, resultsSheet.getLastRow() - 1, 1).getValues();
      let totalScore = 0;
      resultsData.forEach(row => { totalScore += Number(row[0]) || 0; });
      averageScore = resultsData.length > 0 ? Math.round(totalScore / resultsData.length) : 0;
    }
    return { totalAssigned: totalAssigned, pendingCount: pendingCount, completedCount: completedCount, averageScore: averageScore };
  } catch (error) { console.error('Error getting quiz statistics:', error); return { totalAssigned: 0, pendingCount: 0, completedCount: 0, averageScore: 0 }; }
}

function getQuizCountForTrainee(traineeEmail) {
  try {
    initializeQuizSheets();
    const ss = getSpreadsheet();
    const assignSheet = ss.getSheetByName(ASSIGNED_QUIZ_SHEET_NAME);
    let pendingCount = 0, completedCount = 0;
    if (assignSheet && assignSheet.getLastRow() > 1) {
      const data = assignSheet.getRange(2, 3, assignSheet.getLastRow() - 1, 7).getValues();
      data.forEach(row => {
        if (String(row[0]).toLowerCase().trim() === String(traineeEmail).toLowerCase().trim()) {
          if (String(row[6]).trim() === 'Pending') pendingCount++;
          if (String(row[6]).trim() === 'Completed') completedCount++;
        }
      });
    }
    return { pendingCount: pendingCount, completedCount: completedCount };
  } catch (error) { console.error('Error getting quiz count:', error); return { pendingCount: 0, completedCount: 0 }; }
}

function exportQuizResultsCSV(filters) {
  try {
    const data = getQuizResultsForTrainer(filters);
    const results = data.results || [];
    if (results.length === 0) return 'No data to export';
    const headers = ['Batch', 'Trainee Name', 'Trainee Email', 'Application', 'Test Number', 'Total Questions', 'Correct Answers', 'Score %', 'Status', 'Submitted Date', 'Time Taken'];
    let csv = headers.join(',') + '\n';
    results.forEach(r => {
      const status = r.scorePercentage >= 70 ? 'Passed' : 'Failed';
      const timeTaken = r.timeTaken ? Math.floor(r.timeTaken / 60) + 'm ' + (r.timeTaken % 60) + 's' : '-';
      csv += [r.batch || '-', '"' + (r.traineeName || '-').replace(/"/g, '""') + '"', r.traineeEmail || '-', '"' + (r.application || '-').replace(/"/g, '""') + '"', r.testNumber || '-', r.totalQuestions || 0, r.correctAnswers || 0, r.scorePercentage || 0, status, r.submittedDate || '-', timeTaken].join(',') + '\n';
    });
    return csv;
  } catch (error) { console.error('Error exporting quiz results:', error); return 'Error exporting data: ' + error.message; }
}

