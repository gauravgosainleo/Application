function initializeQuizSheets() {
  const ss = getSpreadsheet();

  let assignSheet = ss.getSheetByName(ASSIGNED_QUIZ_SHEET_NAME);
  if (!assignSheet) {
    assignSheet = ss.insertSheet(ASSIGNED_QUIZ_SHEET_NAME);
    const assignHeaders = [
      'Assignment ID', 'Batch', 'Trainee Email', 'Trainee Name',
      'Application', 'Test Number', 'Assigned By', 'Assigned Date',
      'Status', 'Due Date'
    ];
    assignSheet.getRange(1, 1, 1, assignHeaders.length).setValues([assignHeaders]);
    assignSheet.getRange(1, 1, 1, assignHeaders.length).setFontWeight('bold');
    assignSheet.getRange(1, 1, 1, assignHeaders.length).setBackground('#4285f4');
    assignSheet.getRange(1, 1, 1, assignHeaders.length).setFontColor('#ffffff');
    assignSheet.setFrozenRows(1);
  }

  let resultsSheet = ss.getSheetByName(QUIZ_RESULTS_SHEET_NAME);
  if (!resultsSheet) {
    resultsSheet = ss.insertSheet(QUIZ_RESULTS_SHEET_NAME);
    const resultsHeaders = [
      'Result ID', 'Assignment ID', 'Batch', 'Trainee Email', 'Trainee Name',
      'Application', 'Test Number', 'Total Questions', 'Correct Answers',
      'Score Percentage', 'Submitted Date', 'Time Taken (mins)', 'Answers JSON'
    ];
    resultsSheet.getRange(1, 1, 1, resultsHeaders.length).setValues([resultsHeaders]);
    resultsSheet.getRange(1, 1, 1, resultsHeaders.length).setFontWeight('bold');
    resultsSheet.getRange(1, 1, 1, resultsHeaders.length).setBackground('#34a853');
    resultsSheet.getRange(1, 1, 1, resultsHeaders.length).setFontColor('#ffffff');
    resultsSheet.setFrozenRows(1);
  }

  return { success: true, message: 'Quiz sheets initialized successfully' };
}

function getQuizApplications() {
