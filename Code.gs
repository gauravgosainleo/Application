// ==================== SETTINGS (CATEGORIES & APPLICATIONS) ====================

function ensureSettingsSheet_() {
  const ss = getSpreadsheet();
  let sheet = ss.getSheetByName(SETTINGS_SHEET_NAME);

  if (!sheet) {
    sheet = ss.insertSheet(SETTINGS_SHEET_NAME);
    // Column A = Categories, Column C = Applications (Column B blank)
    sheet.getRange(1, 1, 1, 3).setValues([['Training Categories', '', 'Applications']]);
    sheet.getRange(1, 1, 1, 3).setFontWeight('bold');
    sheet.setFrozenRows(1);
  }

  const lastRow = sheet.getLastRow();
  const catValues = lastRow >= 2 ? sheet.getRange(2, 1, lastRow - 1, 1).getValues().flat().filter(Boolean) : [];
  const appValues = lastRow >= 2 ? sheet.getRange(2, 3, lastRow - 1, 1).getValues().flat().filter(Boolean) : [];

  if (catValues.length === 0) {
    sheet.getRange(2, 1, DEFAULT_TRAINING_CATEGORIES.length, 1)
      .setValues(DEFAULT_TRAINING_CATEGORIES.map(x => [x]));
  }
  if (appValues.length === 0) {
    sheet.getRange(2, 3, DEFAULT_APPLICATIONS.length, 1)
      .setValues(DEFAULT_APPLICATIONS.map(x => [x]));
  }

  return sheet;
}

function getUserTypeByEmail_(email) {
  const ss = getSpreadsheet();
  const sheet = ss.getSheetByName(LOGIN_SHEET_NAME);
  if (!sheet || sheet.getLastRow() < 2) return '';

  const data = sheet.getDataRange().getValues();
  const target = String(email || '').trim().toLowerCase();

  for (let i = 1; i < data.length; i++) {
    const rowEmail = String(data[i][1]).trim().toLowerCase(); // Column B
    const rowType = String(data[i][6]).trim();               // Column G
    if (rowEmail && rowEmail === target) return rowType;
  }
  return '';
}

function assertTrainer_(userEmail) {
  const type = (getUserTypeByEmail_(userEmail) || '').toLowerCase().trim();
  if (type !== 'trainer') throw new Error('Access denied: Only Trainers can use Settings.');
}

/**
 * Used by UI to populate dropdowns dynamically
 */
function getDropdownOptions() {
  const sheet = ensureSettingsSheet_();
  const lastRow = sheet.getLastRow();

  const cats = lastRow >= 2 ? sheet.getRange(2, 1, lastRow - 1, 1).getValues().flat() : [];
  const apps = lastRow >= 2 ? sheet.getRange(2, 3, lastRow - 1, 1).getValues().flat() : [];

  const categories = cats.map(v => String(v || '').trim()).filter(Boolean);
  const applications = apps.map(v => String(v || '').trim()).filter(Boolean);

  const uniqKeepCase = (arr) => {
    const seen = new Set();
    const out = [];
    arr.forEach(x => {
      const k = x.toLowerCase();
      if (!seen.has(k)) {
        seen.add(k);
        out.push(x);
      }
    });
    return out;
  };

  return {
    categories: uniqKeepCase(categories).sort((a, b) => a.localeCompare(b)),
    applications: uniqKeepCase(applications).sort((a, b) => a.localeCompare(b))
  };
}

/**
 * Settings action: add a new Training Category (trainer only)
 */
function addTrainingCategoryOption(category, userEmail) {
  assertTrainer_(userEmail);

  const value = String(category || '').trim();
  if (!value) return { success: false, message: 'Category cannot be empty.' };

  const opts = getDropdownOptions();
  if (opts.categories.some(c => c.toLowerCase() === value.toLowerCase())) {
    return { success: false, message: 'Category already exists.' };
  }

  const sheet = ensureSettingsSheet_();
  const lastRow = Math.max(sheet.getLastRow(), 1);
  sheet.getRange(lastRow + 1, 1).setValue(value);

  // Create a new sheet for this category with same headers as ILT
  createCategorySheet_(value);

  return { success: true, message: 'Training category added successfully.' };
}

/**
 * Creates a new sheet for a category with the same headers as ILT
 */
function createCategorySheet_(categoryName) {
  const ss = getSpreadsheet();
  const sheetName = categoryName;

  // Check if sheet already exists
  let sheet = ss.getSheetByName(sheetName);
  if (sheet) {
    return sheet; // Sheet already exists
  }

  // Create new sheet with ILT headers
  const iltHeaders = ['Batch', 'Category', 'Application', 'Trainee Name', 'Trainee Email', 'Level', 'Start Date', 'End Date', 'Duration (Days)'];
  sheet = ss.insertSheet(sheetName);
  sheet.getRange(1, 1, 1, iltHeaders.length).setValues([iltHeaders]);
  sheet.getRange(1, 1, 1, iltHeaders.length).setFontWeight('bold');
  sheet.setFrozenRows(1);

  return sheet;
}

/**
 * Settings action: add a new Application (trainer only)
 */
function addApplicationOption(application, userEmail) {
  assertTrainer_(userEmail);

  const value = String(application || '').trim();
  if (!value) return { success: false, message: 'Application cannot be empty.' };

  const opts = getDropdownOptions();
  if (opts.applications.some(a => a.toLowerCase() === value.toLowerCase())) {
