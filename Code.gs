// ==================== CATEGORY DASHBOARD DATA ====================

function getCategoryDashboardData(categoryName) {
  try {
    const ss = getSpreadsheet();
    const defaultCategories = ['ilt', 'sbl', 'isms', 'misc'];
    const isDefaultCategory = defaultCategories.includes(categoryName.toLowerCase());
    const sheetName = isDefaultCategory ? 'ILT' : categoryName;
    const sheet = ss.getSheetByName(sheetName);

    if (!sheet || sheet.getLastRow() < 2) {
      return { totalTrainings: 0, totalTrainees: 0, upcomingTrainings: 0, recentTrainings: [] };
    }

    const data = sheet.getRange(2, 1, sheet.getLastRow() - 1, 9).getValues();
    const today = new Date();
    const uniqueTrainings = new Set();
    const uniqueTrainees = new Set();
    let upcomingCount = 0;
    const recentTrainings = [];

    data.forEach(row => {
      if (!row[0]) return;
      const rowCategory = String(row[1]).trim().toLowerCase();
      if (isDefaultCategory && rowCategory !== categoryName.toLowerCase()) return;

      uniqueTrainings.add(row[0] + '|' + row[2]);
      uniqueTrainees.add(row[4]);
      const startDate = new Date(row[6]);
      if (startDate > today) upcomingCount++;
    });

    const seenTrainings = new Set();
    for (let i = data.length - 1; i >= 0 && recentTrainings.length < 10; i--) {
      if (!data[i][0]) continue;
      const rowCategory = String(data[i][1]).trim().toLowerCase();
      if (isDefaultCategory && rowCategory !== categoryName.toLowerCase()) continue;

      const key = data[i][0] + '|' + data[i][2];
      if (!seenTrainings.has(key)) {
        seenTrainings.add(key);
        const startDate = new Date(data[i][6]);
        const status = startDate > today ? 'Scheduled' : (new Date(data[i][7]) < today ? 'Completed' : 'In Progress');
        recentTrainings.push({
          batch: data[i][0],
          application: data[i][2],
          startDate: Utilities.formatDate(new Date(data[i][6]), Session.getScriptTimeZone(), 'yyyy-MM-dd'),
          endDate: Utilities.formatDate(new Date(data[i][7]), Session.getScriptTimeZone(), 'yyyy-MM-dd'),
          status: status
        });
      }
    }

    return { totalTrainings: uniqueTrainings.size, totalTrainees: uniqueTrainees.size, upcomingTrainings: upcomingCount, recentTrainings: recentTrainings };
  } catch (error) {
    console.error('Error getting category dashboard data:', error);
    return { totalTrainings: 0, totalTrainees: 0, upcomingTrainings: 0, recentTrainings: [] };
  }
}

// ==================== COMPLIANCE DASHBOARD DATA ====================

function getComplianceDashboardData() {
  try {
    const ss = getSpreadsheet();
    const eventsSheet = ss.getSheetByName('Compliance_Events');
    const statusSheet = ss.getSheetByName('Compliance_Status');

    let totalEvents = 0, upcomingEvents = 0, avgCompliance = 0;
    const today = new Date();

    if (eventsSheet && eventsSheet.getLastRow() > 1) {
      const eventsData = eventsSheet.getRange(2, 1, eventsSheet.getLastRow() - 1, 7).getValues();
      totalEvents = eventsData.length;
      eventsData.forEach(row => {
        if (row[4] && new Date(row[4]) > today) upcomingEvents++;
      });
    }

    if (statusSheet && statusSheet.getLastRow() > 1) {
      const statusData = statusSheet.getRange(2, 5, statusSheet.getLastRow() - 1, 1).getValues();
      let totalComp = 0;
      statusData.forEach(row => { totalComp += Number(row[0]) || 0; });
      avgCompliance = statusData.length > 0 ? Math.round(totalComp / statusData.length) : 0;
    }

    return { totalEvents: totalEvents, upcomingEvents: upcomingEvents, avgCompliance: avgCompliance };
  } catch (error) {
    console.error('Error getting compliance dashboard data:', error);
    return { totalEvents: 0, upcomingEvents: 0, avgCompliance: 0 };
  }
}
