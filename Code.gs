// ==================== TRAINING PROGRESS FUNCTIONS ====================

function initializeProgressSheet() {
  const ss = getSpreadsheet();
  let sheet = ss.getSheetByName('Training_Progress');

  if (!sheet) {
    sheet = ss.insertSheet('Training_Progress');
    const headers = ['Trainee Email', 'Trainee Name', 'Batch', 'Application', 'Day', 'Topic', 'Status', 'Marked By', 'Marked Date', 'Start Date', 'End Date'];
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
    sheet.setFrozenRows(1);
  }

  return sheet;
}

function createProgressEntries(trainingData) {
  try {
    const progressSheet = initializeProgressSheet();
    const rowsToAdd = [];

    trainingData.applications.forEach(app => {
      const syllabus = getSyllabusForApplication(app);

      trainingData.traineeEmails.forEach((email, i) => {
        syllabus.forEach(topic => {
          rowsToAdd.push([
            email,
            trainingData.traineeNames[i],
            trainingData.batchCount,
            app,
            topic.day,
            topic.topic,
            'Not Done',
            '',
            '',
            trainingData.startDate,
            trainingData.endDate
          ]);
        });
      });
    });

    if (rowsToAdd.length > 0) {
      const lastRow = progressSheet.getLastRow();
      progressSheet.getRange(lastRow + 1, 1, rowsToAdd.length, 11).setValues(rowsToAdd);
    }

    return { success: true, entriesCreated: rowsToAdd.length };
  } catch (error) {
    console.error('Error creating progress entries:', error);
    return { success: false, message: error.message };
  }
}

function getTrainingsForTrainer(filters) {
  try {
    const ss = getSpreadsheet();
    const iltSheet = ss.getSheetByName('ILT');

    if (!iltSheet || iltSheet.getLastRow() < 2) {
      return { trainings: [] };
    }

    const data = iltSheet.getRange(2, 1, iltSheet.getLastRow() - 1, 9).getValues();
    const trainingsMap = {};

    data.forEach(row => {
      if (!row[0]) return;

      const traineeEmail = String(row[4]).toLowerCase().trim();
      const traineeName = String(row[3]).trim();
      const application = String(row[2]).trim();
      const batch = String(row[0]).trim();
      let startDate = row[6];
      let endDate = row[7];

      if (filters) {
        if (filters.traineeName && !traineeName.toLowerCase().includes(filters.traineeName.toLowerCase())) return;
        if (filters.application && application !== filters.application) return;
        if (filters.startDate) {
          const filterStart = new Date(filters.startDate);
          const rowStart = new Date(startDate);
          if (rowStart < filterStart) return;
        }
        if (filters.endDate) {
          const filterEnd = new Date(filters.endDate);
          const rowEnd = new Date(endDate);
          if (rowEnd > filterEnd) return;
        }
      }

      if (startDate instanceof Date) startDate = Utilities.formatDate(startDate, Session.getScriptTimeZone(), 'yyyy-MM-dd');
      if (endDate instanceof Date) endDate = Utilities.formatDate(endDate, Session.getScriptTimeZone(), 'yyyy-MM-dd');

      const key = `${batch}|${application}|${traineeEmail}`;

      if (!trainingsMap[key]) {
        trainingsMap[key] = {
          batch: batch,
          application: application,
          traineeEmail: traineeEmail,
          traineeName: traineeName,
          startDate: startDate,
          endDate: endDate,
          level: row[5]
        };
      }
    });

    return { trainings: Object.values(trainingsMap) };
  } catch (error) {
    console.error('Error getting trainings for trainer:', error);
    return { trainings: [] };
  }
}

function getTraineeProgress(traineeEmail, application, batch) {
  try {
    const ss = getSpreadsheet();
    const progressSheet = ss.getSheetByName('Training_Progress');

    if (!progressSheet || progressSheet.getLastRow() < 2) {
      const syllabus = getSyllabusForApplication(application);
      return {
        progress: syllabus.map(topic => ({
          day: topic.day,
          topic: topic.topic,
          status: 'Not Done',
          markedBy: '',
          markedDate: ''
        })),
        fromSyllabus: true
      };
    }

    const data = progressSheet.getRange(2, 1, progressSheet.getLastRow() - 1, 11).getValues();
    const progress = [];

    data.forEach((row, index) => {
      const rowEmail = String(row[0]).toLowerCase().trim();
      const rowApp = String(row[3]).trim();
      const rowBatch = String(row[2]).trim();

      if (rowEmail === String(traineeEmail).toLowerCase() &&
        rowApp.toLowerCase().includes(String(application).toLowerCase().split(',')[0].trim()) &&
        (!batch || rowBatch === batch)) {
        progress.push({
          rowIndex: index + 2,
          day: row[4],
          topic: row[5],
          status: row[6] || 'Not Done',
          markedBy: row[7] || '',
          markedDate: row[8] ? Utilities.formatDate(new Date(row[8]), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm') : ''
        });
      }
    });

    if (progress.length === 0) {
      const syllabus = getSyllabusForApplication(application);
      return {
        progress: syllabus.map(topic => ({
          day: topic.day,
          topic: topic.topic,
          status: 'Not Done',
          markedBy: '',
          markedDate: ''
        })),
        fromSyllabus: true
      };
    }

    return { progress: progress, fromSyllabus: false };
  } catch (error) {
    console.error('Error getting trainee progress:', error);
    return { progress: [], error: error.message };
  }
}

function markTopicStatus(traineeEmail, application, batch, day, topic, status, trainerEmail) {
  try {
    const ss = getSpreadsheet();
    let progressSheet = ss.getSheetByName('Training_Progress');

    if (!progressSheet) {
      progressSheet = initializeProgressSheet();
    }

    const data = progressSheet.getRange(2, 1, Math.max(progressSheet.getLastRow() - 1, 1), 11).getValues();
    let rowFound = false;

    for (let i = 0; i < data.length; i++) {
      const rowEmail = String(data[i][0]).toLowerCase().trim();
      const rowApp = String(data[i][3]).trim();
      const rowBatch = String(data[i][2]).trim();
      const rowDay = String(data[i][4]).trim();
      const rowTopic = String(data[i][5]).trim();

      if (rowEmail === String(traineeEmail).toLowerCase() &&
        rowApp.toLowerCase().includes(String(application).toLowerCase().split(',')[0].trim()) &&
        rowBatch === batch &&
        rowDay === day &&
        rowTopic === topic) {

        const rowIndex = i + 2;
        progressSheet.getRange(rowIndex, 7).setValue(status);
        progressSheet.getRange(rowIndex, 8).setValue(trainerEmail);
        progressSheet.getRange(rowIndex, 9).setValue(new Date());
        rowFound = true;
        break;
      }
    }

    if (!rowFound) {
      const iltSheet = ss.getSheetByName('ILT');
      let traineeName = '';
      let startDate = '';
      let endDate = '';

      if (iltSheet && iltSheet.getLastRow() > 1) {
        const iltData = iltSheet.getRange(2, 1, iltSheet.getLastRow() - 1, 9).getValues();
        for (const row of iltData) {
          if (String(row[4]).toLowerCase().trim() === String(traineeEmail).toLowerCase() &&
            String(row[0]).trim() === batch) {
            traineeName = row[3];
            startDate = row[6] instanceof Date ? Utilities.formatDate(row[6], Session.getScriptTimeZone(), 'yyyy-MM-dd') : row[6];
            endDate = row[7] instanceof Date ? Utilities.formatDate(row[7], Session.getScriptTimeZone(), 'yyyy-MM-dd') : row[7];
            break;
          }
        }
      }

      progressSheet.appendRow([
        traineeEmail,
        traineeName,
        batch,
        application,
        day,
        topic,
        status,
        trainerEmail,
        new Date(),
        startDate,
        endDate
      ]);
    }

    return { success: true, message: `Topic marked as ${status}` };
  } catch (error) {
    console.error('Error marking topic status:', error);
    return { success: false, message: error.message };
  }
}

function getTraineeProgressSummary(traineeEmail) {
  try {
    const ss = getSpreadsheet();
    const iltSheet = ss.getSheetByName('ILT');
    const progressSheet = ss.getSheetByName('Training_Progress');

    if (!iltSheet || iltSheet.getLastRow() < 2) {
      return { trainings: [] };
    }

    const iltData = iltSheet.getRange(2, 1, iltSheet.getLastRow() - 1, 9).getValues();
    const trainingsMap = {};

    iltData.forEach(row => {
      const rowEmail = String(row[4]).toLowerCase().trim();
      if (rowEmail !== String(traineeEmail).toLowerCase()) return;

      const key = `${row[0]}|${row[2]}`;

      if (!trainingsMap[key]) {
        let startDate = row[6];
        let endDate = row[7];

        if (startDate instanceof Date) startDate = Utilities.formatDate(startDate, Session.getScriptTimeZone(), 'yyyy-MM-dd');
        if (endDate instanceof Date) endDate = Utilities.formatDate(endDate, Session.getScriptTimeZone(), 'yyyy-MM-dd');

        trainingsMap[key] = {
          batch: row[0],
          application: row[2],
          startDate: startDate,
          endDate: endDate,
          level: row[5],
          totalTopics: 0,
          completedTopics: 0
        };
      }
    });

    if (progressSheet && progressSheet.getLastRow() > 1) {
      const progressData = progressSheet.getRange(2, 1, progressSheet.getLastRow() - 1, 11).getValues();

      progressData.forEach(row => {
        const rowEmail = String(row[0]).toLowerCase().trim();
        if (rowEmail !== String(traineeEmail).toLowerCase()) return;

        const key = `${row[2]}|${row[3]}`;

        if (trainingsMap[key]) {
          trainingsMap[key].totalTopics++;
          if (row[6] === 'Done') trainingsMap[key].completedTopics++;
        }
      });
    }

    const trainings = Object.values(trainingsMap).map(t => ({
      ...t,
      progressPercent: t.totalTopics > 0 ? Math.round((t.completedTopics / t.totalTopics) * 100) : 0
    }));

    return { trainings: trainings };
  } catch (error) {
    console.error('Error getting trainee progress summary:', error);
    return { trainings: [], error: error.message };
  }
}

