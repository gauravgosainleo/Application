function assignQuizToTrainees(assignmentData) {
  try {
    initializeQuizSheets();
    const ss = getSpreadsheet();
    const assignSheet = ss.getSheetByName(ASSIGNED_QUIZ_SHEET_NAME);
    const loginSheet = ss.getSheetByName(LOGIN_SHEET_NAME);
    const loginData = loginSheet.getDataRange().getValues();
    const traineeNames = {};
    for (let i = 1; i < loginData.length; i++) {
      traineeNames[String(loginData[i][1]).toLowerCase().trim()] = String(loginData[i][0]).trim();
    }
    const lastRow = assignSheet.getLastRow();
    let nextId = 1;
    if (lastRow > 1) {
      const lastId = assignSheet.getRange(lastRow, 1).getValue();
      const idNum = parseInt(String(lastId).replace('QA', '')) || 0;
      nextId = idNum + 1;
    }
    const rowsToAdd = [];
    const assignedDate = new Date();
    assignmentData.traineeEmails.forEach((email, index) => {
      const assignmentId = 'QA' + String(nextId + index).padStart(5, '0');
      const traineeName = traineeNames[email.toLowerCase().trim()] || email;
      rowsToAdd.push([
        assignmentId, assignmentData.batch || '', email, traineeName,
        assignmentData.application, assignmentData.testNumber,
        assignmentData.assignedBy, assignedDate, 'Pending', assignmentData.dueDate || ''
      ]);
    });
    if (rowsToAdd.length > 0) {
      assignSheet.getRange(lastRow + 1, 1, rowsToAdd.length, 10).setValues(rowsToAdd);
    }
    return { success: true, message: `Quiz assigned to ${rowsToAdd.length} trainee(s) successfully` };
  } catch (error) { console.error('Error assigning quiz:', error); return { success: false, message: error.message }; }
}

function getPendingQuizzesForTrainee(traineeEmail) {
